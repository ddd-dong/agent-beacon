#!/bin/sh
# agent-beacon：把 agent 事件轉發到儀表板。
#
#   Claude Code hook：beacon claude        （事件 JSON 從 stdin 進來）
#   Codex notify：    beacon codex '<json>'（事件 JSON 是最後一個參數）
#
# 規則：
#   - 只送事件名、session id、cwd、host、agent、時間、/rename 取的名字、背景工作的類型與數量；
#     prompt、回覆、工具內容、背景工作的指令與描述一律不送
#   - 背景 POST，2 秒 timeout，永遠 exit 0
#   - 不輸出任何東西（UserPromptSubmit / SessionStart 的 stdout 會被注入 Claude 的 context）

exec >/dev/null 2>&1

# 儀表板用這個判斷 session 是不是還在用舊版 beacon
BEACON_VERSION=7

agent="${1:-claude}"
[ $# -gt 0 ] && shift


CONF_DIR="${AGENT_BEACON_HOME:-$HOME/.config/agent-beacon}"

# 送一筆只有事件名的事件（給背景監看用）
post_simple() {
  [ -r "$CONF_DIR/env" ] && . "$CONF_DIR/env"
  [ -n "${BEACON_URL:-}" ] && [ -n "${BEACON_TOKEN:-}" ] || return 0
  set -- -fsS -m 5 -X POST -H "Content-Type: application/json" \
    --data "$(printf '{"event":"%s","session_id":"%s","agent":"claude","beacon":%s}' "$1" "$2" "$BEACON_VERSION")"
  [ -n "${BEACON_CACERT:-}" ] && set -- "$@" --cacert "$BEACON_CACERT"
  [ "${BEACON_INSECURE:-0}" = 1 ] && set -- "$@" -k
  [ -n "${BEACON_CURL_EXTRA:-}" ] && set -- "$@" $BEACON_CURL_EXTRA
  printf 'header = "Authorization: Bearer %s"\n' "$BEACON_TOKEN" | curl -K - "$@" "${BEACON_URL%/}/api/agent/events"
}

# Claude Code 底下、Bash 工具開的 shell（命令列含 shell-snapshots）
bash_tool_shells() {
  for c in $(pgrep -P "$1" 2>/dev/null); do
    ps -o args= -p "$c" 2>/dev/null | grep -q "shell-snapshots" && echo "$c"
  done
}

if [ "$agent" = __watch ]; then
  :
elif [ "$agent" = codex ]; then
  payload="${1:-}"
else
  payload="$(cat)"
fi

# 背景監看模式：權限視窗跳出後，等 Claude Code 開出新的 Bash shell（= 使用者核准、指令開始跑），
# 回報 PermissionGranted 讓儀表板切回 running。hook 沒有「核准之後」的事件，這是唯一可靠的訊號。
# 參數：__watch <claude pid> <session id> "<當下已存在的 shell pid>" <pid 檔>
if [ "$agent" = __watch ]; then
  cpid=$1 session=$2 base=" $3 " pidfile=$4
  echo "$$" > "$pidfile"  # 自己寫入：同一個 session 新的監看啟動時，舊的看到不是自己就結束
  n=0
  while [ "$n" -lt 600 ]; do  # 每 3 秒一次，最多 30 分鐘
    sleep 3
    n=$((n + 1))
    kill -0 "$cpid" 2>/dev/null || break
    [ "$(cat "$pidfile" 2>/dev/null)" = "$$" ] || exit 0  # 已有更新的監看接手
    for c in $(bash_tool_shells "$cpid"); do
      case "$base" in *" $c "*) ;; *) post_simple PermissionGranted "$session"; rm -f "$pidfile"; exit 0 ;; esac
    done
  done
  rm -f "$pidfile"
  exit 0
fi

# Codex：安裝前若已有 notify，原本的指令照樣執行（一行一個參數）
if [ "$agent" = codex ] && [ -r "$CONF_DIR/codex-notify-orig" ]; then
  (
    set --
    while IFS= read -r arg || [ -n "$arg" ]; do set -- "$@" "$arg"; done < "$CONF_DIR/codex-notify-orig"
    [ $# -gt 0 ] && "$@" "$payload"
  ) &
fi

[ -r "$CONF_DIR/env" ] && . "$CONF_DIR/env"
[ -n "${BEACON_URL:-}" ] && [ -n "${BEACON_TOKEN:-}" ] || exit 0

# 從 JSON 取字串欄位，取第一個出現的（頂層欄位在前，工具參數裡的同名 key 在後）。
# 跳脫過的引號（例如 prompt 裡的 \"cwd\"）不會被誤認成 key。
field() {
  printf '%s\n' "$payload" | tr '\n' ' ' \
    | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -n 1 \
    | sed "s/^\"$1\"[[:space:]]*:[[:space:]]*\"//; s/\"\$//; s/\\\\*\$//"
}

if [ "$agent" = codex ]; then
  event="$(field type)"
  session="$(field thread-id)"
else
  event="$(field hook_event_name)"
  session="$(field session_id)"
fi
# PostToolUse / PostToolUseFailure 的 payload 含工具參數與輸出，只取事件名與 session id
cwd=""
case "$event" in PostToolUse|PostToolUseFailure) ;; *) cwd="$(field cwd)" ;; esac
ntype="$(field notification_type)"
[ -n "$event" ] && [ -n "$session" ] || exit 0

# 使用者用 /rename 取的名字：transcript 裡最後一筆 custom-title（自動產生的 ai-title 不算）。
# 只送名字本身。PostToolUse 太頻繁，不查。
title=""
if [ "$agent" = claude ] && [ "$event" != PostToolUse ] && [ "$event" != PostToolUseFailure ]; then
  # Windows 的路徑在 JSON 裡是 C:\\Users\\...，轉成 C:/Users/... Git Bash 才讀得到
  tp="$(field transcript_path | sed 's|\\\\|/|g')"
  [ -n "$tp" ] && [ -r "$tp" ] && title="$(grep -o '"customTitle":"[^"]*"' "$tp" 2>/dev/null | tail -n 1 \
    | sed 's/^"customTitle":"//; s/"$//; s/\\*$//')"
fi

# Stop 時還在跑的背景工作（背景 shell、Monitor、subagent…）：只數類型，不送指令或描述。
# payload 可能是多行 JSON、字串裡可能有任何字元，所以用 awk 逐字解析，只看 background_tasks 陣列
# 裡每個物件的 type 與 status，略過已結束的。輸出例如 {"shell":1,"monitor":2}。
background_counts() {
  # $1 = all：不過濾、以「類型:狀態」計數（診斷用：文件沒列出 status 的可能值）
  awk -v mode="${1:-active}" 'BEGIN { RS = "\001" }
  {
    s = $0; n = length(s); depth = 0; instr = 0; esc = 0; tok = ""; key = ""; inbg = 0; bgd = 0
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (instr) {
        if (esc) { esc = 0; tok = tok c; continue }
        if (c == "\\") { esc = 1; continue }
        if (c != "\"") { tok = tok c; continue }
        instr = 0
        j = i + 1; while (j <= n && substr(s, j, 1) ~ /[ \t\r\n]/) j++
        if (substr(s, j, 1) == ":") { key = tok; continue }
        if (inbg && depth == bgd + 1) { if (key == "type") t = tok; else if (key == "status") st = tok }
        key = ""; continue
      }
      if (c == "\"") { instr = 1; tok = ""; continue }
      if (c == "{" || c == "[") {
        depth++
        if (c == "[" && key == "background_tasks" && depth == 2) { inbg = 1; bgd = depth }
        if (inbg && c == "{" && depth == bgd + 1) { t = ""; st = "" }
        key = ""; continue
      }
      if (c == "}" || c == "]") {
        if (inbg && c == "}" && depth == bgd + 1 && t != "") {
          if (mode == "all") cnt[t ":" (st == "" ? "none" : st)]++
          else if (tolower(st) !~ /^(completed|complete|done|failed|killed|stopped|cancell?ed|error|exited)$/) cnt[t]++
        }
        if (inbg && c == "]" && depth == bgd) inbg = 0
        depth--
      }
    }
  }
  END {
    out = ""
    for (k in cnt) { name = tolower(k); gsub(/[^a-z0-9:]+/, "_", name); out = out (out == "" ? "" : ",") "\"" name "\":" cnt[k] }
    printf "{%s}", out
  }'
}
background="null"
background_all="null"
if [ "$agent" = claude ] && [ "$event" = Stop ]; then
  background="$(printf '%s' "$payload" | background_counts 2>/dev/null)"
  case "$background" in "{"*"}") ;; *) background="null" ;; esac
  background_all="$(printf '%s' "$payload" | background_counts all 2>/dev/null)"
  case "$background_all" in "{"*"}") ;; *) background_all="null" ;; esac
fi

# 權限視窗跳出：在背景監看使用者有沒有核准（Linux / macOS；Windows 看不到原生 Claude Code 的子行程，略過）
if [ "$agent" = claude ] && [ "$event" = Notification ] && [ "$ntype" = permission_prompt ] \
   && command -v pgrep >/dev/null 2>&1; then
  p=$PPID cpid="" i=0
  while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null && [ "$i" -lt 8 ]; do
    case "$(ps -o comm= -p "$p" 2>/dev/null | sed 's/^ *//; s/ *$//; s|.*/||')" in
      claude|claude.exe|node) cpid=$p; break ;;
    esac
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    i=$((i + 1))
  done
  if [ -n "$cpid" ]; then
    pidfile="$CONF_DIR/watch-$(printf '%s' "$session" | tr -cd 'A-Za-z0-9-').pid"
    base=$(bash_tool_shells "$cpid" | tr '\n' ' ')
    w=""
    command -v setsid >/dev/null 2>&1 && w="setsid"
    ( trap '' HUP; $w sh "$0" __watch "$cpid" "$session" "$base" "$pidfile" </dev/null & )
  fi
fi

host="$(hostname 2>/dev/null || uname -n)"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
body=$(printf '{"event":"%s","session_id":"%s","agent":"%s","cwd":"%s","host":"%s","ts":"%s","notification_type":"%s","title":"%s","background":%s,"background_all":%s,"beacon":%s}' \
  "$event" "$session" "$agent" "$cwd" "$host" "$ts" "$ntype" "$title" "$background" "$background_all" "$BEACON_VERSION")

set -- -fsS -m 2 -X POST -H "Content-Type: application/json" --data "$body"
[ -n "${BEACON_CACERT:-}" ] && set -- "$@" --cacert "$BEACON_CACERT"
[ "${BEACON_INSECURE:-0}" = 1 ] && set -- "$@" -k
# Windows Schannel 的 --ssl-no-revoke 等（install.sh 偵測後寫進 env）
[ -n "${BEACON_CURL_EXTRA:-}" ] && set -- "$@" $BEACON_CURL_EXTRA

# 有 setsid 就脫離 hook 的行程群組，agent 結束（SessionEnd）時請求不會被一起砍掉
detach=""
command -v setsid >/dev/null 2>&1 && detach="setsid"

# token 走 curl 的 config stdin，不出現在 ps 的指令列
(
  trap '' HUP
  printf 'header = "Authorization: Bearer %s"\n' "$BEACON_TOKEN" \
    | $detach curl -K - "$@" "${BEACON_URL%/}/api/agent/events" &
) &
exit 0
