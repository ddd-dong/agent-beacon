#!/bin/sh
# agent-beacon 啟動器（hook 固定呼叫這支）。
#
# Claude Code 在 session 啟動時就把 hook 的路徑固定在當時的 plugin 版本資料夾；plugin 自動更新後，
# 已開著的 session 還是會執行舊版。這支啟動器每次都去找已安裝的最新版 beacon-core 來執行，
# 所以之後更新 beacon 不用重開 session。
#
# 版本資料夾結構：.../cache/<marketplace>/<plugin>/<version>/bin/beacon-core
# 只在同一個 plugin 的版本資料夾之間挑（同樣是 Claude Code 安裝的 plugin 檔案），找不到就用自己旁邊那份。

self_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || exit 0
latest=""
for f in "$self_dir"/../../*/bin/beacon-core; do
  [ -f "$f" ] || continue
  if [ -z "$latest" ] || [ "$f" -nt "$latest" ]; then
    latest=$f
  fi
done
[ -n "$latest" ] || latest="$self_dir/beacon-core"
exec sh "$latest" "$@"
